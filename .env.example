# Copy to .env and fill in, then: set -a && source .env && set +a
# In GitHub Actions these come from repository Secrets instead — see README.

# Email digest (--digest). All four are required together; miss one and the
# poller falls back to stdout rather than failing the run.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=                 # Gmail App Password, 16 chars, NOT your account password
EMAIL_TO=you@gmail.com     # comma-separated for more than one recipient
# EMAIL_FROM=              # optional, defaults to SMTP_USER

# Optional Telegram fallback, used only when SMTP is not configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
